# Terraform working dirs (downloaded providers/modules; recreated by `terraform init`)
.terraform/

# State: contains resource IDs and can contain secrets (e.g. DB passwords) in plaintext
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variable values: project IDs, billing account IDs, emails. Commit only *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local-only overrides and crash dumps
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# Plan files can contain sensitive values
*.tfplan
tfplan

# Credentials / key files (we use impersonation, so none should exist, but belt and braces)
*.json.key
*-key.json
*credentials*.json
*service-account*.json
*.pem
*.p12
.env

# OS / editor
.DS_Store
.idea/
.vscode/

# NOTE: .terraform.lock.hcl is intentionally NOT ignored; it pins provider versions + checksums.
